# ==============================================================================
# INCUBRIX SCRIPT & VOICEOVER TO B-ROLL VIDEO ENGINE - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Metadata & Server
APP_NAME="IncuBrix Script & Voiceover to B-Roll Engine"
APP_VERSION=1.0.0
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Database Configuration
# Default is local async SQLite. For PostgreSQL, set: postgresql+asyncpg://user:pass@host:5432/incubrix
DATABASE_URL=sqlite+aiosqlite:///./data/incubrix.db

# Storage Adapter Configuration
# Supported options: "local" or "s3"
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./storage

# S3 / MinIO Storage Configuration (Used when STORAGE_BACKEND=s3)
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET_NAME=incubrix-videos
S3_ACCESS_KEY=incubrixadmin
S3_SECRET_KEY=incubrixpassword2026
S3_REGION=us-east-1

# Media Binaries (Leave as 'ffmpeg' and 'ffprobe' if in PATH, or specify full executable paths)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Optional External Footage Providers (Free developer API keys)
# If empty, the engine automatically uses the 100% deterministic local procedural fallback visual generator.
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Speech Synthesis & Audio Limits
DEFAULT_VOICE=en-US-AriaNeural
MAX_AUDIO_DURATION_SECONDS=600
MAX_UPLOAD_SIZE_BYTES=52428800

# Security, Webhooks & Callbacks
WEBHOOK_SECRET=incubrix-signature-secret-key-2026
